# ── 資料庫 ─────────────────────────────────────────────
# 開發預設使用 SQLite（免安裝、開箱即用）
DATABASE_URL="file:./dev.db"
#
# 正式環境改用 PostgreSQL，並將 prisma/schema.prisma 的
# datasource provider 改為 "postgresql"：
# DATABASE_URL="postgresql://user:password@localhost:5432/method_erp?schema=public"

# ── AI 供應商 ───────────────────────────────────────────
# 系統會自動偵測你填了哪一把金鑰：
#   • 填 GEMINI_API_KEY    → 使用 Google Gemini（有免費額度，推薦先用這個）
#   • 填 ANTHROPIC_API_KEY → 使用 Anthropic Claude
#   • 兩個都填時，可用 AI_PROVIDER 指定要用哪個；不指定則優先 Gemini
# AI_PROVIDER="gemini"   # 或 "anthropic"

# ── Google Gemini（免費）───────────────────────────────
# 申請金鑰：https://aistudio.google.com/apikey （用 Google 帳號登入即可，免信用卡）
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ── Anthropic Claude（需付費儲值）──────────────────────
# 申請金鑰：https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
