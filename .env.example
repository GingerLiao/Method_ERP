# ── 資料庫（PostgreSQL）────────────────────────────────
# 使用雲端 PostgreSQL（推薦 Neon，免費）。本機開發與雲端部署用同一條連線字串。
# 從 Neon 主控台複製「Connection string」貼在這裡，結尾要有 ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/method_erp?sslmode=require"

# ── AI 供應商 ───────────────────────────────────────────
# 系統會自動偵測你填了哪一把金鑰：
#   • 填 GEMINI_API_KEY    → 使用 Google Gemini（有免費額度，推薦先用這個）
#   • 填 ANTHROPIC_API_KEY → 使用 Anthropic Claude
#   • 兩個都填時，可用 AI_PROVIDER 指定要用哪個；不指定則優先 Gemini
# AI_PROVIDER="gemini"   # 或 "anthropic"

# ── Google Gemini（免費）───────────────────────────────
# 申請金鑰：https://aistudio.google.com/apikey （用 Google 帳號登入即可，免信用卡）
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# ── Anthropic Claude（需付費儲值）──────────────────────
# 申請金鑰：https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
